{
  "schemaVersion": 1,
  "id": "phantomspawnoverhaul",
  "version": "${version}",
  "name": "Phantom Spawn Overhaul",
  "description": "A simple Minecraft mod which will provide an alternative path for phantoms to spawn. Allows phantoms to spawn on a player by using a potion of Insomnia.",
  "authors": [
    "JensenJ - Developer"
  ],
  "contact": {
    "sources": "https://github.com/JensenJ-Modding/Phantom-Spawn-Overhaul",
    "issues": "https://github.com/JensenJ-Modding/Phantom-Spawn-Overhaul/issues"
  },
  "license": "MIT License",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.phantomspawnoverhaul.fabric.PhantomSpawnOverhaulFabric"
    ]
  },
  "mixins": [
    "phantomspawnoverhaul-common.mixins.json",
    "phantomspawnoverhaul-fabric.mixins.json"
  ],
  "depends": {
    "fabric": "*",
    "minecraft": ">=1.21.1",
    "architectury": ">=13.0.8",
    "forgeconfigapiport": ">=21.1.3"
  }
}